<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<ScrollPane fitToHeight="true" fitToWidth="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.test_student_management.controller.SignUpController"
            style="-fx-background-color: #1a0a2e; -fx-background: #1a0a2e;">

    <content>
        <StackPane alignment="CENTER" style="-fx-background-color: #1a0a2e;">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40" />
            </padding>

            <!-- Ambient Background Glows -->
            <Rectangle width="400" height="400"
                       style="-fx-fill: radial-gradient(center 50% 50%, radius 50%, #a855f718, transparent);"
                       translateX="120" translateY="-100" />
            <Rectangle width="350" height="350"
                       style="-fx-fill: radial-gradient(center 50% 50%, radius 50%, #7c3aed15, transparent);"
                       translateX="-120" translateY="120" />

            <!-- Clean, Borderless Content Wrapper -->
            <VBox alignment="CENTER" spacing="0" maxWidth="320">

                <!-- Header Section -->
                <VBox alignment="CENTER" spacing="6">
                    <Label text="Create Account"
                           style="-fx-font-size: 26px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #f3e8ff;" />
                    <Label text="Register a new account below"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #a78bfa;" />
                </VBox>

                <Region minHeight="35" />

                <!-- Form Fields -->
                <VBox spacing="16" maxWidth="Infinity">
                    <VBox spacing="6">
                        <Label text="Username"
                               style="-fx-font-size: 12px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #c4b5fd;" />
                        <TextField fx:id="usernameField"
                                   promptText="Choose a username"
                                   style="-fx-background-color: #25143e;
                                          -fx-background-radius: 8;
                                          -fx-border-color: #6d28d966;
                                          -fx-border-radius: 8;
                                          -fx-border-width: 1.2;
                                          -fx-text-fill: #f3e8ff;
                                          -fx-prompt-text-fill: #63469f;
                                          -fx-padding: 12 14 12 14;
                                          -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Password"
                               style="-fx-font-size: 12px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #c4b5fd;" />
                        <PasswordField fx:id="passwordField"
                                       promptText="Choose a password"
                                       style="-fx-background-color: #25143e;
                                              -fx-background-radius: 8;
                                              -fx-border-color: #6d28d966;
                                              -fx-border-radius: 8;
                                              -fx-border-width: 1.2;
                                              -fx-text-fill: #f3e8ff;
                                              -fx-prompt-text-fill: #63469f;
                                              -fx-padding: 12 14 12 14;
                                              -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Confirm Password"
                               style="-fx-font-size: 12px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #c4b5fd;" />
                        <PasswordField fx:id="confirmPasswordField"
                                       promptText="Re-enter your password"
                                       style="-fx-background-color: #25143e;
                                              -fx-background-radius: 8;
                                              -fx-border-color: #6d28d966;
                                              -fx-border-radius: 8;
                                              -fx-border-width: 1.2;
                                              -fx-text-fill: #f3e8ff;
                                              -fx-prompt-text-fill: #63469f;
                                              -fx-padding: 12 14 12 14;
                                              -fx-font-size: 13px;" />
                    </VBox>
                </VBox>

                <Region minHeight="30" />

                <!-- Actions Section -->
                <VBox spacing="12" maxWidth="Infinity">
                    <Button text="Create Account"
                            onAction="#handleCreateAccount"
                            maxWidth="Infinity"
                            style="-fx-background-color: linear-gradient(to right, #7c3aed, #a855f7);
                                   -fx-background-radius: 8;
                                   -fx-text-fill: white;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-padding: 12 0 12 0;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, #7c3aed66, 12, 0.4, 0, 4);" />

                    <HBox alignment="CENTER" spacing="10">
                        <Separator HBox.hgrow="ALWAYS" style="-fx-background-color: #3b1875;" />
                        <Label text="or" style="-fx-text-fill: #63469f; -fx-font-size: 12px;" />
                        <Separator HBox.hgrow="ALWAYS" style="-fx-background-color: #3b1875;" />
                    </HBox>

                    <Button text="Back to Login"
                            onAction="#handleBackToLogin"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent;
                                   -fx-background-radius: 8;
                                   -fx-border-color: #7c3aed88;
                                   -fx-border-radius: 8;
                                   -fx-border-width: 1.2;
                                   -fx-text-fill: #c4b5fd;
                                   -fx-font-size: 13px;
                                   -fx-padding: 11 0 11 0;
                                   -fx-cursor: hand;" />
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>