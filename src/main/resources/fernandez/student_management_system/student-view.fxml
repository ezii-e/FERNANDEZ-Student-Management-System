<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<ScrollPane fitToHeight="true" fitToWidth="true"
            hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fernandez.student_management_system.controller.StudentController"
            style="-fx-background-color: #1a0a2e; -fx-background: #1a0a2e;">

    <content>
        <VBox spacing="0" style="-fx-background-color: transparent;">

            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: #2d1b4e;
                         -fx-border-color: #4c1d95;
                         -fx-border-width: 0 0 1 0;">
                <padding>
                    <Insets top="14" right="24" bottom="14" left="24" />
                </padding>

                <StackPane>
                    <Rectangle width="34" height="34"
                               style="-fx-fill: linear-gradient(to bottom right, #7c3aed, #a855f7);
                                      -fx-arc-width: 10; -fx-arc-height: 10;" />
                    <Label text="✦"
                           style="-fx-font-size: 16px; -fx-text-fill: white;" />
                </StackPane>

                <VBox spacing="1">
                    <Label text="Student Management System"
                           style="-fx-font-size: 16px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #f3e8ff;" />
                    <Label text="Manage student records"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #a78bfa;" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button text="Logout"
                        onAction="#handleLogout"
                        style="-fx-background-color: transparent;
                               -fx-border-color: #7c3aed;
                               -fx-border-radius: 6;
                               -fx-border-width: 1;
                               -fx-text-fill: #c4b5fd;
                               -fx-font-size: 12px;
                               -fx-padding: 6 14 6 14;
                               -fx-cursor: hand;" />
            </HBox>

            <VBox spacing="16" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="20" right="24" bottom="20" left="24" />
                </padding>

                <VBox spacing="16"
                      style="-fx-background-color: #2d1b4e;
                             -fx-background-radius: 12;
                             -fx-border-color: #4c1d95;
                             -fx-border-width: 1;
                             -fx-border-radius: 12;">
                    <padding>
                        <Insets top="18" right="20" bottom="18" left="20" />
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Rectangle width="4" height="18"
                                   style="-fx-fill: linear-gradient(to bottom, #7c3aed, #a855f7);
                                          -fx-arc-width: 4; -fx-arc-height: 4;" />
                        <Label text="Student Record"
                               style="-fx-font-size: 14px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #e9d5ff;" />
                    </HBox>

                    <Separator style="-fx-background-color: #4c1d95;" />

                    <GridPane hgap="14" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="90" maxWidth="110" />
                            <ColumnConstraints hgrow="ALWAYS" />
                            <ColumnConstraints minWidth="90" maxWidth="110" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="36" />
                            <RowConstraints minHeight="36" />
                            <RowConstraints minHeight="36" />
                            <RowConstraints minHeight="36" />
                        </rowConstraints>

                        <Label text="ID"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #c4b5fd;" />
                        <TextField fx:id="idField"
                                   editable="false" promptText="Auto-generated"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"
                                   style="-fx-background-color: #1e1035;
                                          -fx-background-radius: 6;
                                          -fx-border-color: #4c1d95;
                                          -fx-border-radius: 6;
                                          -fx-border-width: 1;
                                          -fx-text-fill: #7c6aa0;
                                          -fx-prompt-text-fill: #4c3a70;
                                          -fx-padding: 8 12 8 12;
                                          -fx-font-size: 12px;" />

                        <Label text="Student No."
                               GridPane.rowIndex="0" GridPane.columnIndex="2"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #c4b5fd;" />
                        <TextField fx:id="studentNumberField"
                                   promptText="2026-0001"
                                   GridPane.rowIndex="0" GridPane.columnIndex="3"
                                   style="-fx-background-color: #3b2460;
                                          -fx-background-radius: 6;
                                          -fx-border-color: #6d28d9;
                                          -fx-border-radius: 6;
                                          -fx-border-width: 1;
                                          -fx-text-fill: #f3e8ff;
                                          -fx-prompt-text-fill: #7c5cbf;
                                          -fx-padding: 8 12 8 12;
                                          -fx-font-size: 12px;" />

                        <Label text="First Name"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #c4b5fd;" />
                        <TextField fx:id="firstNameField"
                                   promptText="Juan"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"
                                   style="-fx-background-color: #3b2460;
                                          -fx-background-radius: 6;
                                          -fx-border-color: #6d28d9;
                                          -fx-border-radius: 8;
                                          -fx-border-width: 1;
                                          -fx-text-fill: #f3e8ff;
                                          -fx-prompt-text-fill: #7c5cbf;
                                          -fx-padding: 8 12 8 12;
                                          -fx-font-size: 12px;" />

                        <Label text="Last Name"
                               GridPane.rowIndex="1" GridPane.columnIndex="2"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #c4b5fd;" />
                        <TextField fx:id="lastNameField"
                                   promptText="Dela Cruz"
                                   GridPane.rowIndex="1" GridPane.columnIndex="3"
                                   style="-fx-background-color: #3b2460;
                                          -fx-background-radius: 6;
                                          -fx-border-color: #6d28d9;
                                          -fx-border-radius: 6;
                                          -fx-border-width: 1;
                                          -fx-text-fill: #f3e8ff;
                                          -fx-prompt-text-fill: #7c5cbf;
                                          -fx-padding: 8 12 8 12;
                                          -fx-font-size: 12px;" />

                        <Label text="Course"
                               GridPane.rowIndex="2" GridPane.columnIndex="0"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #c4b5fd;" />
                        <TextField fx:id="courseField"
                                   promptText="BSIT"
                                   GridPane.rowIndex="2" GridPane.columnIndex="1"
                                   style="-fx-background-color: #3b2460;
                                          -fx-background-radius: 6;
                                          -fx-border-color: #6d28d9;
                                          -fx-border-radius: 6;
                                          -fx-border-width: 1;
                                          -fx-text-fill: #f3e8ff;
                                          -fx-prompt-text-fill: #7c5cbf;
                                          -fx-padding: 8 12 8 12;
                                          -fx-font-size: 12px;" />

                        <Label text="Year Level"
                               GridPane.rowIndex="2" GridPane.columnIndex="2"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #c4b5fd;" />
                        <TextField fx:id="yearLevelField"
                                   promptText="1"
                                   GridPane.rowIndex="2" GridPane.columnIndex="3"
                                   style="-fx-background-color: #3b2460;
                                          -fx-background-radius: 6;
                                          -fx-border-color: #6d28d9;
                                          -fx-border-radius: 6;
                                          -fx-border-width: 1;
                                          -fx-text-fill: #f3e8ff;
                                          -fx-prompt-text-fill: #7c5cbf;
                                          -fx-padding: 8 12 8 12;
                                          -fx-font-size: 12px;" />

                        <Label text="Email"
                               GridPane.rowIndex="3" GridPane.columnIndex="0"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #c4b5fd;" />
                        <TextField fx:id="emailField"
                                   promptText="student@example.com"
                                   GridPane.rowIndex="3" GridPane.columnIndex="1"
                                   style="-fx-background-color: #3b2460;
                                          -fx-background-radius: 6;
                                          -fx-border-color: #6d28d9;
                                          -fx-border-radius: 6;
                                          -fx-border-width: 1;
                                          -fx-text-fill: #f3e8ff;
                                          -fx-prompt-text-fill: #7c5cbf;
                                          -fx-padding: 8 12 8 12;
                                          -fx-font-size: 12px;" />

                        <Label text="Phone"
                               GridPane.rowIndex="3" GridPane.columnIndex="2"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #c4b5fd;" />
                        <TextField fx:id="phoneField"
                                   promptText="09xxxxxxxxx"
                                   GridPane.rowIndex="3" GridPane.columnIndex="3"
                                   style="-fx-background-color: #3b2460;
                                          -fx-background-radius: 6;
                                          -fx-border-color: #6d28d9;
                                          -fx-border-radius: 6;
                                          -fx-border-width: 1;
                                          -fx-text-fill: #f3e8ff;
                                          -fx-prompt-text-fill: #7c5cbf;
                                          -fx-padding: 8 12 8 12;
                                          -fx-font-size: 12px;" />
                    </GridPane>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="＋  Add"
                                onAction="#handleAdd"
                                style="-fx-background-color: linear-gradient(to right, #7c3aed, #a855f7);
                                       -fx-background-radius: 7;
                                       -fx-text-fill: white;
                                       -fx-font-size: 12px;
                                       -fx-font-weight: bold;
                                       -fx-padding: 8 18 8 18;
                                       -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, #7c3aed88, 8, 0.3, 0, 2);" />

                        <Button text="✎  Update"
                                onAction="#handleUpdate"
                                style="-fx-background-color: #4c1d95;
                                       -fx-background-radius: 7;
                                       -fx-border-color: #7c3aed;
                                       -fx-border-radius: 7;
                                       -fx-border-width: 1;
                                       -fx-text-fill: #e9d5ff;
                                       -fx-font-size: 12px;
                                       -fx-font-weight: bold;
                                       -fx-padding: 8 18 8 18;
                                       -fx-cursor: hand;" />

                        <Button text="✕  Delete"
                                onAction="#handleDelete"
                                style="-fx-background-color: #3b1040;
                                       -fx-background-radius: 7;
                                       -fx-border-color: #9d174d;
                                       -fx-border-radius: 7;
                                       -fx-border-width: 1;
                                       -fx-text-fill: #fda4af;
                                       -fx-font-size: 12px;
                                       -fx-font-weight: bold;
                                       -fx-padding: 8 18 8 18;
                                       -fx-cursor: hand;" />

                        <Button text="↺  Clear"
                                onAction="#handleClear"
                                style="-fx-background-color: transparent;
                                       -fx-background-radius: 7;
                                       -fx-border-color: #4c1d95;
                                       -fx-border-radius: 7;
                                       -fx-border-width: 1;
                                       -fx-text-fill: #a78bfa;
                                       -fx-font-size: 12px;
                                       -fx-padding: 8 18 8 18;
                                       -fx-cursor: hand;" />
                    </HBox>
                </VBox>

                <VBox spacing="12" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #2d1b4e;
                             -fx-background-radius: 12;
                             -fx-border-color: #4c1d95;
                             -fx-border-width: 1;
                             -fx-border-radius: 12;">
                    <padding>
                        <Insets top="18" right="20" bottom="18" left="20" />
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Rectangle width="4" height="18"
                                   style="-fx-fill: linear-gradient(to bottom, #7c3aed, #a855f7);
                                          -fx-arc-width: 4; -fx-arc-height: 4;" />
                        <Label text="Student Records"
                               style="-fx-font-size: 14px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #e9d5ff;" />
                    </HBox>

                    <Separator style="-fx-background-color: #4c1d95;" />

                    <TableView fx:id="studentTable" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent;
                                      -fx-border-color: #4c1d95;
                                      -fx-border-radius: 8;
                                      -fx-border-width: 1;
                                      -fx-table-cell-border-color: #3b2460;
                                      -fx-control-inner-background: #241350;
                                      -fx-control-inner-background-alt: #2a1660;
                                      -fx-selection-bar: #6d28d9;
                                      -fx-selection-bar-non-focused: #4c1d95;
                                      -fx-text-fill: #e9d5ff;
                                      -fx-font-size: 12px;"
                               minHeight="200">
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" prefWidth="60"
                                         style="-fx-alignment: CENTER;" />
                            <TableColumn fx:id="studentNumberColumn" text="Student No." prefWidth="130" />
                            <TableColumn fx:id="firstNameColumn" text="First Name" prefWidth="140" />
                            <TableColumn fx:id="lastNameColumn" text="Last Name" prefWidth="140" />
                            <TableColumn fx:id="courseColumn" text="Course" prefWidth="110"
                                         style="-fx-alignment: CENTER;" />
                            <TableColumn fx:id="yearLevelColumn" text="Year" prefWidth="60"
                                         style="-fx-alignment: CENTER;" />
                            <TableColumn fx:id="emailColumn" text="Email" prefWidth="210" />
                            <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="130" />
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER">
                        <Pagination fx:id="studentPagination"
                                    pageCount="1"
                                    maxPageIndicatorCount="5"
                                    style="-fx-background-color: transparent;
                                           -fx-border-color: transparent;
                                           -fx-page-information-visible: false;" />
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
